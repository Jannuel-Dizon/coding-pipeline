{
  "$schema": "https://opencode.ai/config.json",

  // PROJECT LAYER — facts, not process. Copied to .opencode/opencode.jsonc by
  // /init (only when the file is missing). Everything below is commented out:
  // with nothing uncommented, this project simply inherits the global config.
  //
  // OpenCode V2 merge rules (per https://opencode.ai/v2/docs/agents/):
  //   - scalar keys you set here (model, description, ...) replace the global
  //     value for that agent only
  //   - `permissions` rules APPEND after the global rules, and the LAST
  //     matching rule wins — so a rule here can tighten or loosen the global
  //     one for this repo without restating the whole block
  //   - you do NOT have to redefine every agent; override only what differs
  //     (this replaces the pre-2.0 "define all seven or none" rule, which came
  //     from V1's replace-the-whole-agent merging)
  //
  // Untested against a live V2 session as of pipeline 2.0.0 — if an override
  // here seems ignored, check `opencode.ai/v2/docs/config` precedence first.

  // "agents": {
  //   // Pin a paid, zero-retention model for the stage that reads real source:
  //   "arch": { "model": "opencode/deepseek-v4-flash#max" },
  //
  //   // T3 is the one place a free-tier retention caveat is hardest to defend:
  //   "build-critical": { "model": "opencode/claude-opus-5#max" },
  //
  //   // Tighten the planner's read wall to this repo's layout. These append
  //   // after the global rules and win because they match last:
  //   "design": {
  //     "permissions": [
  //       { "action": "read", "resource": "src/**", "effect": "deny" },
  //       { "action": "read", "resource": "src/lib.rs", "effect": "allow" }
  //     ]
  //   }
  // },

  // Project-specific check commands for the build agents. `shell` patterns
  // ending in " *" also match the bare command in V2.
  // "permissions": [
  //   { "action": "shell", "resource": "cargo check *", "effect": "allow" },
  //   { "action": "shell", "resource": "cargo test *", "effect": "allow" },
  //   { "action": "shell", "resource": "./Check.sh *", "effect": "allow" }
  // ]
}
