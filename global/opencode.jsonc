{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ask",
  "subagent_depth": 1,
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "rm *": "deny",
      "git push*": "deny"
    },
    "external_directory": {
      "*": "ask"
    },
    "edit": {
      "*": "ask"
    },
    "doom_loop": "ask"
  },
  "agent": {
    "ask": {
      "mode": "primary",
      "description": "Casual Q&A, outside the pipeline. No handoff doc, no template, no tier. For quick questions not worth a planning session.",
      // "model": "opencode-go/deepseek-v4-flash",
      "model": "opencode-go/glm-5.3-flash",
      "variant": "low",
      "temperature": 0.3,
      "prompt": "{file:./prompts/ask.md}",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "edit": "deny",
        "write": "deny",
        "grep": "allow",
        "glob": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "cat *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "echo *": "allow",
          "cd *": "allow",
          "find *": "allow",
          "xargs grep*": "allow",
          "xargs cat*": "allow",
          "xargs wc*": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "cargo tree*": "allow",
          "rm *": "deny",
          "mv *": "deny",
          "cp *": "deny",
          "curl *": "deny",
          "wget *": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "*-exec*": "deny"
        },
        "task": "deny"
      }
    },
    "design": {
      "mode": "primary",
      "description": "Stage 1. Designs a slice with you. Reads project shape, never implementation bodies. Writes to handoff/1-plan/.",
      // "model": "opencode-go/deepseek-v4-flash",
      "model": "opencode-go/glm-5.3-flash",
      "variant": "high",
      "temperature": 0.3,
      "prompt": "{file:./prompts/plan.md}",
      "permission": {
        "read": {
          "*": "allow",
          "**/*.rs": "deny",
          "**/*.ts": "deny",
          "**/*.tsx": "deny",
          "**/*.js": "deny",
          "**/*.jsx": "deny",
          "**/*.py": "deny",
          "**/*.go": "deny",
          "**/*.java": "deny",
          "**/*.c": "deny",
          "**/*.h": "deny",
          "**/*.cpp": "deny",
          "**/*.hpp": "deny",
          "**/lib.rs": "allow",
          "**/mod.rs": "allow",
          "**/index.ts": "allow",
          "**/*.d.ts": "allow",
          "**/__init__.py": "allow",
          "**/*.md": "allow",
          "**/*.toml": "allow",
          "**/*.json": "allow",
          "**/*.yaml": "allow",
          "**/*.yml": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "edit": {
          "*": "deny",
        },
        "write": {
          "*": "deny",
        },
        "grep": "deny",
        "glob": "allow",
        "bash": "deny",
        "task": {
          "*": "deny",
          "explore": "allow",
          "scribe": "allow"
        }
      }
    },
    "arch": {
      "mode": "primary",
      "description": "Stage 2. Verifies a plan against the real codebase, assigns a build tier, writes a spec to handoff/2-spec/. Never edits source.",
      // "model": "opencode-go/deepseek-v4-flash",
      "model": "opencode-go/glm-5.3-flash",
      "variant": "max",
      "temperature": 0.2,
      "prompt": "{file:./prompts/arch.md}",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "edit": {
          "*": "deny",
        },
        "write": {
          "*": "deny",
        },
        "grep": "allow",
        "glob": "allow",
        "bash": {
          "*": "allow",
          "ls *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "wc *": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "cargo tree*": "allow",
          "cargo metadata*": "allow",
          "rm *": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git checkout*": "deny",
          "git reset*": "deny"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "scribe": "allow"
        }
      }
    },
    "build": {
      "mode": "primary",
      "description": "Stage 3, tier T1 (routine). Implements a T1 spec. Cheap model, mechanical work only.",
      // "model": "opencode-go/deepseek-v4-flash",
      "model": "opencode-go/glm-5.3-flash",
      "variant": "low",
      "temperature": 0.1,
      "prompt": "{file:./prompts/build.md}",
      "permission": {
        "edit": {
          "*": "ask",
        },
        "write": {
          "*": "ask",
        },
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "rg *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "rm *": "deny",
          "git commit*": "ask",
          "git push*": "deny",
          "git reset*": "deny"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "scribe": "allow"
        }
      }
    },
    "build-hard": {
      "mode": "primary",
      "description": "Stage 3, tier T2 (hard). Implements a T2 spec. Non-obvious logic spanning modules.",
      // "model": "opencode-go/deepseek-v4-flash",
      "model": "opencode-go/glm-5.3-flash",
      "variant": "high",
      "temperature": 0.1,
      "prompt": "{file:./prompts/build-hard.md}",
      "permission": {
        "edit": {
          "*": "ask",
        },
        "write": {
          "*": "ask",
        },
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "rg *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "rm *": "deny",
          "git commit*": "ask",
          "git push*": "deny",
          "git reset*": "deny"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "scribe": "allow"
        }
      }
    },
    "build-critical": {
      "mode": "primary",
      "description": "Stage 3, tier T3 (critical). Safety- or security-critical code only. Narrow scope, per-edit approval, adversarial pass required.",
      // "model": "opencode-go/deepseek-v4-flash",
      "model": "opencode-go/glm-5.3-flash",
      "variant": "max",
      "temperature": 0.1,
      "prompt": "{file:./prompts/build-critical.md}",
      "permission": {
        "edit": {
          "*": "ask",
        },
        "write": {
          "*": "ask",
        },
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "echo *": "allow",
          "cd *": "allow",
          "find *": "allow",
          "xargs grep*": "allow",
          "cargo check*": "allow",
          "cargo clippy*": "allow",
          "cargo test*": "allow",
          "./Check.sh*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "rm *": "deny",
          "cargo add*": "deny",
          "cargo update*": "deny",
          "git commit*": "ask",
          "git push*": "deny",
          "*-exec*": "deny"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "scribe": "allow"
        }
      }
    },
    "explore": {
      "mode": "subagent",
      "description": "Read-only lookup. Answers one specific question about the codebase in prose. Returns findings and file:line references, never file dumps.",
      "model": "opencode-go/longcat-2.5-preview-free",
      "temperature": 0.1,
      "prompt": "{file:./prompts/explore.md}",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "grep": "allow",
        "glob": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "task": "deny"
      }
    },
    "scribe": {
      "mode": "subagent",
      "description": "Write-only. Places a finished handoff and map document at the correct path. Never composes content.",
      "model": "opencode-go/hy3",
      "temperature": 0,
      "prompt": "{file:./prompts/scribe.md}",
      "permission": {
        "read": "deny",
        "grep": "deny",
        "glob": {
          "*": "deny",
          ".opencode/handoff/**": "allow"
        },
        "edit": {
          "*": "ask",
          ".opencode/handoff/1-plan/**": "allow",
          ".opencode/handoff/2-spec/**": "allow",
          ".opencode/handoff/3-report/**": "allow",
          ".opencode/MAP.md": "allow"
        },
        "write": {
          "*": "ask",
          ".opencode/handoff/1-plan/**": "allow",
          ".opencode/handoff/2-spec/**": "allow",
          ".opencode/handoff/3-report/**": "allow",
          ".opencode/MAP.md": "allow"
        },
        "bash": "deny",
        "webfetch": "deny",
        "task": "deny"
      }
    }
  }
}
